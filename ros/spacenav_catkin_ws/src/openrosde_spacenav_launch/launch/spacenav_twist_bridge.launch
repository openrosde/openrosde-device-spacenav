<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://github.com/ros-drivers/joystick_drivers/tree/main/spacenav_node -->
  <!-- Upstream default: $(find spacenav_node)/launch/classic.launch -->
  <!-- This launch file starts the 'spacenavd' daemon (optionally), the upstream 'spacenav_node' driver (optionally), and the bridge from the 3Dconnexion SpaceMouse to a 'geometry_msgs/TwistStamped' command, MoveIt Servo by default. -->

  <arg name="start_spacenavd" default="true" />
  <arg name="launch_spacenav_node" default="true" />
  <arg name="input_twist_topic" default="/spacenav/twist" />
  <arg name="output_twist_topic" default="/servo_server/delta_twist_cmds" />
  <arg name="joy_topic" default="/spacenav/joy" />
  <arg name="frame_id" default="base_link" />

  <arg name="require_enable_button" default="true" />
  <arg name="enable_button_index" default="0" />
  <arg name="publish_zero_when_disabled" default="true" />

  <arg name="linear_x_scale" default="1.0" />
  <arg name="linear_y_scale" default="1.0" />
  <arg name="linear_z_scale" default="1.0" />
  <arg name="angular_x_scale" default="1.0" />
  <arg name="angular_y_scale" default="1.0" />
  <arg name="angular_z_scale" default="1.0" />
  <!-- Flip the planar translational and tilt axes ('linear_x', 'linear_y', 'angular_x', 'angular_y'), so that operating from in front of the robot feels like operating from behind it. -->
  <arg name="reverse_for_front_view" default="false" />
  <arg name="publish_rate" default="100.0" />
  <arg name="input_timeout" default="0.1" />
  <arg name="linear_deadband" default="0.10" />
  <arg name="angular_deadband" default="0.10" />
  <arg name="linear_smoothing_time_constant" default="0.08" />
  <arg name="angular_smoothing_time_constant" default="0.08" />
  <arg name="max_linear_acceleration" default="4.0" />
  <arg name="max_angular_acceleration" default="6.0" />

  <!-- Start 'spacenavd' first, so it is ready before the 'spacenav_node' driver connects. -->
  <node if="$(arg start_spacenavd)" pkg="openrosde_spacenav_launch" type="spacenavd_daemon.bash" name="spacenavd_daemon" output="screen" />

  <!-- Inline the upstream 'spacenav_node' classic node so it can be marked 'respawn'. -->
  <!-- The driver exits if 'spacenavd' is not accepting connections yet at startup, so respawn lets it reconnect once 'spacenavd' is ready. -->
  <node if="$(arg launch_spacenav_node)" pkg="spacenav_node" type="spacenav_node" name="$(anon spacenav_node)" output="screen" respawn="true" respawn_delay="2">
    <param name="zero_when_static" value="true" />
    <param name="static_count_threshold" value="30" />
  </node>

  <node pkg="openrosde_spacenav_launch"
    type="spacenav_twist_bridge.py"
    name="spacenav_twist_bridge"
    output="screen">
    <param name="input_twist_topic" value="$(arg input_twist_topic)" />
    <param name="output_twist_topic" value="$(arg output_twist_topic)" />
    <param name="joy_topic" value="$(arg joy_topic)" />
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="require_enable_button" value="$(arg require_enable_button)" />
    <param name="enable_button_index" value="$(arg enable_button_index)" />
    <param name="publish_zero_when_disabled" value="$(arg publish_zero_when_disabled)" />
    <param name="linear_x_scale" value="$(eval str(-float(arg('linear_x_scale'))) if str(arg('reverse_for_front_view')).lower() in ['true', '1', 'yes'] else arg('linear_x_scale'))" />
    <param name="linear_y_scale" value="$(eval str(-float(arg('linear_y_scale'))) if str(arg('reverse_for_front_view')).lower() in ['true', '1', 'yes'] else arg('linear_y_scale'))" />
    <param name="linear_z_scale" value="$(arg linear_z_scale)" />
    <param name="angular_x_scale" value="$(eval str(-float(arg('angular_x_scale'))) if str(arg('reverse_for_front_view')).lower() in ['true', '1', 'yes'] else arg('angular_x_scale'))" />
    <param name="angular_y_scale" value="$(eval str(-float(arg('angular_y_scale'))) if str(arg('reverse_for_front_view')).lower() in ['true', '1', 'yes'] else arg('angular_y_scale'))" />
    <param name="angular_z_scale" value="$(arg angular_z_scale)" />
    <param name="publish_rate" value="$(arg publish_rate)" />
    <param name="input_timeout" value="$(arg input_timeout)" />
    <param name="linear_deadband" value="$(arg linear_deadband)" />
    <param name="angular_deadband" value="$(arg angular_deadband)" />
    <param name="linear_smoothing_time_constant" value="$(arg linear_smoothing_time_constant)" />
    <param name="angular_smoothing_time_constant" value="$(arg angular_smoothing_time_constant)" />
    <param name="max_linear_acceleration" value="$(arg max_linear_acceleration)" />
    <param name="max_angular_acceleration" value="$(arg max_angular_acceleration)" />
  </node>

</launch>
